{
  "schema": 1,
  "services": {
    "nodes": {
      "routes": [
        { "method": "POST", "template": "/api/v1/agents/enroll" },
        { "method": "POST", "template": "/api/v1/agents/{nodeId}/heartbeat" },
        { "method": "POST", "template": "/api/v1/agents/{nodeId}/certificates/renew" },
        { "method": "GET", "template": "/api/v1/agents/ca-certificate" },
        { "method": "GET", "template": "/api/v1/organizations/{organizationId}/audit-logs" },
        { "method": "POST", "template": "/api/v1/organizations/{organizationId}/enrollment/tokens" },
        { "method": "GET", "template": "/api/v1/organizations/{organizationId}/enrollment/tokens" },
        { "method": "DELETE", "template": "/api/v1/organizations/{organizationId}/enrollment/tokens/{tokenId}" },
        { "method": "GET", "template": "/api/v1/organizations/{organizationId}/nodes" },
        { "method": "GET", "template": "/api/v1/organizations/{organizationId}/nodes/{nodeId}" },
        { "method": "PATCH", "template": "/api/v1/organizations/{organizationId}/nodes/{nodeId}" },
        { "method": "PUT", "template": "/api/v1/organizations/{organizationId}/nodes/{nodeId}/tags" },
        { "method": "DELETE", "template": "/api/v1/organizations/{organizationId}/nodes/{nodeId}" },
        { "method": "POST", "template": "/api/v1/organizations/{organizationId}/nodes/{nodeId}/maintenance" },
        { "method": "DELETE", "template": "/api/v1/organizations/{organizationId}/nodes/{nodeId}/maintenance" },
        { "method": "POST", "template": "/api/v1/organizations/{organizationId}/nodes/{nodeId}/reservations" },
        { "method": "GET", "template": "/api/v1/organizations/{organizationId}/nodes/{nodeId}/reservations" },
        { "method": "GET", "template": "/api/v1/organizations/{organizationId}/nodes/{nodeId}/reservations/capacity" },
        { "method": "GET", "template": "/api/v1/reservations/{token}" },
        { "method": "POST", "template": "/api/v1/reservations/{token}/claim" },
        { "method": "DELETE", "template": "/api/v1/reservations/{token}" },
        { "method": "*", "template": "/hubs/agent" },
        { "method": "*", "template": "/hubs/agent/negotiate" }
      ],
      "error_codes": [
        "node_not_found",
        "node_unavailable",
        "node_decommissioned",
        "capacity_data_missing",
        "insufficient_memory",
        "insufficient_disk",
        "insufficient_cpu",
        "reservation_not_found",
        "reservation_expired",
        "invalid_platform",
        "invalid_hardware",
        "invalid_token",
        "invalid_public_key",
        "certificate_generation_failed",
        "certificate_required",
        "certificate_not_found",
        "certificate_validation_unavailable",
        "thumbprint_mismatch",
        "name_already_exists",
        "already_in_maintenance",
        "not_in_maintenance",
        "heartbeat_failed",
        "enrollment_failed",
        "invalid_heartbeat",
        "invalid_telemetry",
        "invalid_result",
        "invalid_status",
        "invalid_console_batch",
        "not_supported"
      ],
      "transitions": [
        "node:Enrolling->Online",
        "node:Enrolling->Degraded",
        "node:Enrolling->Decommissioned",
        "node:Online->Degraded",
        "node:Degraded->Online",
        "node:Online->Offline",
        "node:Degraded->Offline",
        "node:Offline->Online",
        "node:Offline->Degraded",
        "node:Online->Maintenance",
        "node:Degraded->Maintenance",
        "node:Offline->Maintenance",
        "node:Maintenance->Online",
        "node:Maintenance->Offline",
        "node:Online->Decommissioned",
        "node:Degraded->Decommissioned",
        "node:Offline->Decommissioned",
        "node:Maintenance->Decommissioned",
        "agent_certificate:active->revoked",
        "enrollment_token:unused->used",
        "enrollment_token:unused->revoked",
        "enrollment_token:used->revoked"
      ]
    },
    "gateway": {
      "routes": [
        { "method": "*", "template": "/api/v1/identity/internal/{**catch-all}" },
        { "method": "*", "template": "/api/v1/betterauth/{**catch-all}" },
        { "method": "*", "template": "/api/v1/identity/{**catch-all}" },
        { "method": "*", "template": "/api/v1/servers/{**catch-all}" },
        { "method": "*", "template": "/api/v1/organizations/{**catch-all}" },
        { "method": "*", "template": "/api/v1/console/{**catch-all}" },
        { "method": "*", "template": "/hubs/console/{**catch-all}" },
        { "method": "*", "template": "/hubs/agent/{**catch-all}" },
        { "method": "*", "template": "/api/v1/notifications/{**catch-all}" },
        { "method": "*", "template": "/api/v1/secrets/{**catch-all}" },
        { "method": "*", "template": "/api/v1/discord/{**catch-all}" },
        { "method": "*", "template": "/api/v1/agents/enroll" },
        { "method": "*", "template": "/api/v1/agents/{**catch-all}" }
      ],
      "error_codes": [],
      "transitions": []
    }
  }
}
