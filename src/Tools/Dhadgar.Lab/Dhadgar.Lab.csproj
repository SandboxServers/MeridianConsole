<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>meridian-lab</AssemblyName>
    <RootNamespace>Dhadgar.Lab</RootNamespace>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StartupObject>Dhadgar.Lab.LabProgram</StartupObject>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- LibraryImport (source-generated P/Invoke) for the L07 Job Object wrapper needs unsafe code enabled. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Dhadgar.Shared\Dhadgar.Shared.csproj" />
    <ProjectReference Include="..\..\Shared\Dhadgar.Contracts\Dhadgar.Contracts.csproj" />
    <ProjectReference Include="..\..\Agents\Dhadgar.Agent.Core\Dhadgar.Agent.Core.csproj" />
    <ProjectReference Include="..\..\Dhadgar.Nodes\Dhadgar.Nodes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="Tomlyn" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="labsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="lab-coverage.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- L52: the behavioural coverage universe (read at run time from the output folder). -->
  <ItemGroup>
    <None Update="coverage-universe.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
